# Django Core Settings
DEBUG=0
SECRET_KEY=change-me-to-a-random-64-char-string
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgres://horilla:change-me-strong-password@db:5432/horilla

# Redis
REDIS_PASSWORD=change-me-strong-password
REDIS_URL=redis://:change-me-strong-password@redis:6379/0

# CSRF
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# CORS
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Localization
LANGUAGE_CODE=it
TIME_ZONE=Europe/Rome

# Demo Data (set to 1 to auto-load demo data on first startup)
LOAD_DEMO_DATA=0
DB_INIT_PASSWORD=change-me-for-web-based-init

# Gunicorn
# GUNICORN_WORKERS=4
# GUNICORN_LOG_LEVEL=info
# GUNICORN_RELOAD=false

# HTTPS Security (uncomment when using HTTPS)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
