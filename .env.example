# Django Core Settings
DEBUG=0
SECRET_KEY=change-me-to-a-random-64-char-string
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgres://horilla:change-me-strong-password@db:5432/horilla

# Redis
REDIS_PASSWORD=change-me-strong-password
REDIS_URL=redis://:change-me-strong-password@redis:6379/0

# CSRF
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# CORS
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# HTTPS Security (uncomment when using HTTPS)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
